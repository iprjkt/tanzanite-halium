#!/sbin/sh
# Tanzanite Format Userdata to ext4 (Recovery Flashable Zip)
# Supports OrangeFox / TWRP recovery on Redmi Note 14 4G (MediaTek MT6789)
# Wipes old F2FS superblocks & crypto signatures, formats to clean ext4, and initializes standard /data hierarchy

set -e

if [ -n "$2" ] && [ -e "/proc/self/fd/$2" ]; then
  OUTFD="/proc/self/fd/$2"
  ui_print() {
    echo "ui_print $1" >> "$OUTFD"
    echo "ui_print" >> "$OUTFD"
  }
else
  ui_print() {
    echo "$1"
  }
fi

abort() {
  ui_print "[!] ERROR: $1"
  ui_print "[!] Aborting operation..."
  rm -rf "$WORK" 2>/dev/null || true
  exit 1
}

ui_print "=============================================="
ui_print "  Redmi Note 14 4G (tanzanite) Ext4 Formatter "
ui_print "  Format /data (userdata) to Clean ext4       "
ui_print "  Dual-Boot / Ubuntu Touch / FBE Disable Tool "
ui_print "  Author  : iprjkt                            "
ui_print "  Telegram: @anotherside551                   "
ui_print "=============================================="

ZIPFILE="$3"
WORK="/tmp/format_ext4_work"
rm -rf "$WORK"
mkdir -p "$WORK/tools"

# Extract bundled tools if running from zip
if [ -n "$ZIPFILE" ] && [ -f "$ZIPFILE" ]; then
  ui_print "[*] Extracting helper tools from zip..."
  unzip -oq "$ZIPFILE" "tools/*" -d "$WORK" 2>/dev/null || true
fi

chmod -R 755 "$WORK/tools" 2>/dev/null || true
export PATH="$WORK/tools:$PATH"

# 1. Locate userdata block device
ui_print "[*] Detecting userdata partition..."
USERDATA_DEV=""

for dev in \
  /dev/block/by-name/userdata \
  /dev/block/bootdevice/by-name/userdata \
  /dev/block/platform/bootdevice/by-name/userdata \
  /dev/block/platform/*/by-name/userdata \
  /dev/block/mapper/userdata \
  /dev/block/sdc75; do
  if [ -b "$dev" ]; then
    USERDATA_DEV=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
    break
  fi
done

if [ -z "$USERDATA_DEV" ] || [ ! -b "$USERDATA_DEV" ]; then
  abort "Could not find userdata block device!"
fi

ui_print "[+] Target block device: $USERDATA_DEV"

# 2. Get partition capacity
PART_BYTES=$(blockdev --getsize64 "$USERDATA_DEV" 2>/dev/null || echo 0)
if [ "$PART_BYTES" -gt 0 ]; then
  PART_MB=$(( PART_BYTES / 1048576 ))
  PART_GB=$(( PART_MB / 1024 ))
  ui_print "[*] Partition capacity : ${PART_GB} GB (${PART_MB} MB)"
else
  PART_MB=0
fi

# 3. Kill locks and unmount all mountpoints referencing /data or userdata
ui_print "[*] Ensuring partition is fully unmounted..."
fuser -k -9 /data 2>/dev/null || true
fuser -k -9 /sdcard 2>/dev/null || true
fuser -k -9 "$USERDATA_DEV" 2>/dev/null || true

umount -f -l /data/media/0 2>/dev/null || true
umount -f -l /data/media 2>/dev/null || true
umount -f -l /sdcard 2>/dev/null || true
umount -f -l /data 2>/dev/null || true
umount -f -l "$USERDATA_DEV" 2>/dev/null || true

# Check /proc/mounts to ensure no active mounts remain
if grep -q "$USERDATA_DEV" /proc/mounts 2>/dev/null; then
  grep "$USERDATA_DEV" /proc/mounts | while read -r line; do
    mp=$(echo "$line" | awk '{print $2}')
    [ -n "$mp" ] && umount -f -l "$mp" 2>/dev/null || true
  done
fi

sleep 1

# 4. Wipe old superblocks, crypto tokens, and filesystem signatures
ui_print "[*] Erasing legacy superblocks & encryption metadata..."
# Zero out first 32 MB
dd if=/dev/zero of="$USERDATA_DEV" bs=1M count=32 conv=notrunc 2>/dev/null || true

# Zero out last 32 MB (removes crypto footer & backup superblocks)
if [ "$PART_MB" -gt 64 ]; then
  SEEK_MB=$(( PART_MB - 32 ))
  dd if=/dev/zero of="$USERDATA_DEV" bs=1M count=32 seek="$SEEK_MB" conv=notrunc 2>/dev/null || true
fi
sync

# 5. Format to ext4
ui_print "[*] Formatting userdata to ext4 (4K block size, 1% reserve)..."
FORMAT_OK=0

# Determine formatting utility
if command -v mke2fs >/dev/null 2>&1; then
  ui_print "[*] Using mke2fs..."
  if mke2fs -F -t ext4 -b 4096 -m 1 -L userdata \
    -O has_journal,extent,huge_file,flex_bg,uninit_bg,dir_nlink,extra_isize,64bit \
    "$USERDATA_DEV" 2>&1 | while read -r line; do ui_print "    $line"; done; then
    FORMAT_OK=1
  elif mke2fs -F -t ext4 -b 4096 -m 1 -L userdata "$USERDATA_DEV" 2>&1 | while read -r line; do ui_print "    $line"; done; then
    FORMAT_OK=1
  fi
fi

if [ "$FORMAT_OK" -ne 1 ] && command -v mkfs.ext4 >/dev/null 2>&1; then
  ui_print "[*] Fallback: using mkfs.ext4..."
  if mkfs.ext4 -F -b 4096 -m 1 -L userdata "$USERDATA_DEV" 2>&1 | while read -r line; do ui_print "    $line"; done; then
    FORMAT_OK=1
  fi
fi

if [ "$FORMAT_OK" -ne 1 ] && command -v make_ext4fs >/dev/null 2>&1; then
  ui_print "[*] Fallback: using make_ext4fs..."
  if make_ext4fs -b 4096 -l "$PART_BYTES" -a /data "$USERDATA_DEV" 2>&1 | while read -r line; do ui_print "    $line"; done; then
    FORMAT_OK=1
  fi
fi

if [ "$FORMAT_OK" -ne 1 ]; then
  abort "All formatting methods failed on $USERDATA_DEV!"
fi

# 6. Tune filesystem parameters
if command -v tune2fs >/dev/null 2>&1; then
  ui_print "[*] Tuning ext4 parameters (disabling periodic fsck)..."
  tune2fs -c -1 -i 0 "$USERDATA_DEV" 2>/dev/null || true
fi

# 7. Check filesystem integrity
if command -v e2fsck >/dev/null 2>&1; then
  ui_print "[*] Verifying ext4 filesystem integrity..."
  e2fsck -fy "$USERDATA_DEV" >/dev/null 2>&1 || true
fi

# 8. Mount and provision default Android /data skeleton
ui_print "[*] Initializing default /data directories & permissions..."
mkdir -p /data 2>/dev/null || true
mount -t ext4 -o rw,noatime "$USERDATA_DEV" /data

# Standard Android root /data permissions
chmod 771 /data
chown 1000:1000 /data 2>/dev/null || chown 0:0 /data

# Create internal storage structure
mkdir -p /data/media/0
mkdir -p /data/media/obb
chmod 770 /data/media
chmod 775 /data/media/0
# media_rw gid is typically 1023
chown -R 1023:1023 /data/media 2>/dev/null || true

# Essential system state directories
mkdir -p /data/system
mkdir -p /data/misc
mkdir -p /data/local/tmp
chmod 775 /data/system 2>/dev/null || true
chmod 771 /data/local/tmp 2>/dev/null || true

sync
umount /data

# Cleanup
rm -rf "$WORK" 2>/dev/null || true

ui_print "=============================================="
ui_print " [✓] SUCCESS: userdata formatted to ext4!     "
ui_print " [✓] Filesystem : ext4 (unencrypted, 4K)      "
ui_print " [✓] Media dir  : /data/media/0 initialized   "
ui_print "----------------------------------------------"
ui_print " PENTING / IMPORTANT:                         "
ui_print " Reboot kembali ke Recovery (Reboot Recovery) "
ui_print " sebelum mem-flash Ubuntu Touch / Halium.     "
ui_print "=============================================="
exit 0
