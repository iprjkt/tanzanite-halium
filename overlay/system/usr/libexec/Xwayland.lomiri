# The intention behind this wrapper is to set the EGL_PLATFORM to "wayland"
# which might be a necessity depending on the driver stack in use (mostly hybris).
# Additionally it allows to selectively en-/disable certain behavior of Xwayland
# using device-info config files.

if [ -f /system/build.prop ]; then
    export EGL_PLATFORM=wayland
fi

# Keep Xwayland linked against the system GLVND libGL.so.1 rather than gl4es.
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    LD_LIBRARY_PATH="$(printf '%s' "$LD_LIBRARY_PATH" | tr ':' '\n' | grep -vx '/usr/local/lib/gl4es' | paste -sd ':' -)"
    if [ -n "$LD_LIBRARY_PATH" ]; then
        export LD_LIBRARY_PATH
    else
        unset LD_LIBRARY_PATH
    fi
fi

# Prevent Xwayland Screen 0 from clamping landscape touch/mouse input to
# Portrait width (1080px on 1080x2400) when Lomiri rotates QML in software.
if [ -f /usr/local/lib/libxwayland_landscape_fix.so ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}/usr/local/lib/libxwayland_landscape_fix.so"
fi

# Additional arguments sourced from device-info config
ARGS=""

XWAYLAND_SHM=$(device-info get XwaylandShm)
HAS_XWAYLAND_SHM=$?

# Default to shm mode on for the phone
if [ "$HAS_XWAYLAND_SHM" = "1" ]; then
    [ -f /system/build.prop ] && ARGS="$ARGS -shm"
elif [ "$HAS_XWAYLAND_SHM" = "0" ]; then
    if [ "$XWAYLAND_SHM" = "true" ]; then
        ARGS="$ARGS -shm"
    fi
fi

exec /usr/bin/Xwayland $@ $ARGS
